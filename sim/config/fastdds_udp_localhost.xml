<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast DDS for Isaac Sim's bundled ROS 2: UDP over the loopback only. Its container cannot share
     shared-memory segments with the stack's, and the machine may sit on a shared LAN. -->
<profiles xmlns="http://www.eprosima.com">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_loopback</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_loopback" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_loopback</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <initialPeersList>
          <locator>
            <udpv4>
              <address>127.0.0.1</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
