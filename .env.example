# Copy to .env; compose.yaml and scripts/manage.sh read it.
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# The follower arm's CAN interface, up at 1 Mbit/s on the host.
PIPER_CAN=can_follower
# Model weights, mounted at /models in the dev container (default: ~/models): sam3/ (SAM 3.1 ONNX,
# engines built there) and graspgenx/ (GraspGenX release checkpoints).
# PIPER_MODELS=/data/models
