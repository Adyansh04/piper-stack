<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelang="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>piper_lerobot</name>
  <version>0.1.0</version>
  <description>LeRobot on the Piper's stack: a bridge node that serves the arm's state and wrist image over ZMQ and turns joint targets into MoveIt Servo jogs, and LeRobot's robot and teleoperator plugins for it.</description>
  <maintainer email="gupta.adyansh@gmail.com">Adyansh Gupta</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>piper_cmake</buildtool_depend>

  <depend>control_msgs</depend>
  <!-- cppzmq's header (cppzmq-dev) comes from the Dockerfile with libzmq. -->
  <depend>libzmq3-dev</depend>
  <depend>moveit_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>moveit_servo</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
