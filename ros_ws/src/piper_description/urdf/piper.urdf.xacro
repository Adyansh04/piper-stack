<?xml version="1.0"?>
<!-- The Piper with its gripper and its ros2_control system, fixed to the world frame.
     Arguments: prefix (link and joint names), hardware (mock|can), can_interface,
     enable_on_activate (true|false), speed_percent. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper">
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="hardware" default="mock"/>
  <xacro:arg name="can_interface" default="can0"/>
  <xacro:arg name="enable_on_activate" default="false"/>
  <xacro:arg name="speed_percent" default="10"/>

  <xacro:include filename="$(find piper_description)/urdf/piper_arm.xacro"/>
  <xacro:include filename="$(find piper_description)/urdf/piper.ros2_control.xacro"/>

  <link name="world"/>
  <joint name="$(arg prefix)world_joint" type="fixed">
    <parent link="world"/>
    <child link="$(arg prefix)base_link"/>
  </joint>

  <xacro:piper_arm prefix="$(arg prefix)"/>
  <xacro:piper_ros2_control prefix="$(arg prefix)" hardware="$(arg hardware)"
                            can_interface="$(arg can_interface)"
                            enable_on_activate="$(arg enable_on_activate)"
                            speed_percent="$(arg speed_percent)"/>
</robot>
