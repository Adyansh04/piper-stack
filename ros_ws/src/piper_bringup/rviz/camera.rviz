Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Coloured cloud
      Enabled: true
      Topic:
        Value: /wrist_camera/depth_registered/points
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 2
    - Class: rviz_default_plugins/Image
      Name: Colour
      Enabled: true
      Topic:
        Value: /wrist_camera/color/image_raw
    - Class: rviz_default_plugins/Image
      Name: Depth
      Enabled: true
      Topic:
        Value: /wrist_camera/depth/image_raw
      Normalize Range: false
      Min Value: 0
      Max Value: 2000
  Global Options:
    Fixed Frame: wrist_camera_link
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Focal Point:
        X: 0.8
        Y: 0.0
        Z: 0.0
      Pitch: 0.3
      Yaw: 3.14
Window Geometry:
  Width: 1600
  Height: 900
