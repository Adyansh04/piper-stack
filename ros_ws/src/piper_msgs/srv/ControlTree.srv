# Pause, hold or resume the running behaviour tree (RunTree's cancel stops it).

# PAUSE: stop ticking; running skills finish their step, nothing new starts.
uint8 PAUSE = 1
# HOLD: stop ticking and halt the running skills (the arm and base stop).
uint8 HOLD = 2
# RESUME: tick again; held skills start again from their beginning.
uint8 RESUME = 3
uint8 command
---
bool success
string message
