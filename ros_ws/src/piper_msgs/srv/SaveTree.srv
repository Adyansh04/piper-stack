# Check behaviour trees and store them as a user's file, then load every tree again.

# A BehaviorTree.CPP 4 XML file (root BTCPP_format="4"): one or more BehaviorTree elements and,
# optionally, their TreeNodesModel.
string xml

# The file's name in the user tree directory, without ".xml"; empty: the first tree's ID.
string name

# true: only check the XML (it parses, every node type and port exists, the trees build).
bool dry_run
---
bool success

# What is wrong when it fails, or where it was saved.
string message

# The IDs of the trees in the XML.
string[] trees
